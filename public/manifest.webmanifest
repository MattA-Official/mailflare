{
  "name": "Flytower Mail",
  "short_name": "Flytower Mail",
  "description": "Mail, calendar and files for the Flytower team.",
  "id": "/",
  "scope": "/",
  "start_url": "/inbox",
  "display": "standalone",
  "background_color": "#10151F",
  "theme_color": "#1B2231",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ]
}
