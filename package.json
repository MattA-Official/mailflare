    "nuxt-auth-utils": "^0.6.2",
    "tailwindcss": "^4.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261112.1",
    "@nuxt/eslint": "^1.17.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14",
    "wrangler": "^4.160.1"
  }
