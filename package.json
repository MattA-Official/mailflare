{
  "name": "mailflare",
  "version": "0.5.4",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "bun run prepare:gen && nuxt dev",
    "build": "bun run prepare:gen && nuxt build",
    "preview": "node scripts/local-wrangler-config.mjs && wrangler dev -c .output/server/wrangler.local.json --port 8787 --test-scheduled",
    "deploy": "bun run build && wrangler deploy",
    "postinstall": "bun run prepare:gen && nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "db:generate": "nuxt db generate",
    "db:bundle": "node scripts/generate-migration-bundle.mjs",
    "routes:generate": "node scripts/generate-route-stubs.mjs",
    "prepare:gen": "bun run db:bundle && bun run routes:generate"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.115",
    "@ai-sdk/openai-compatible": "^3.0.90",
    "@modelcontextprotocol/server": "^2.4.0",
    "@nuxt/ui": "^4.12.0",
    "@nuxthub/core": "^0.10.12",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.1.0",
    "ai": "^7.0.170",
    "bcryptjs": "^3.0.3",
    "css-tree": "^3.2.1",
    "dompurify": "^3.4.17",
    "drizzle-orm": "^0.45.4",
    "mimetext": "^3.0.28",
    "nanoid": "^6.0.2",
    "nuxt": "^4.6.4",
    "nuxt-auth-utils": "^0.6.2",
    "parse-srcset": "^1.0.2",
    "parse5": "^8.1.1",
    "postal-mime": "^4.2.1",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.3.5",
    "workers-ai-provider": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261112.1",
    "@nuxt/eslint": "^1.17.0",
    "@types/css-tree": "^3.2.0",
    "@types/parse-srcset": "^1.0.0",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "typescript": "~5.9",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14",
    "wrangler": "^4.160.1"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "esbuild",
    "workerd",
    "sharp",
    "@parcel/watcher",
    "vue-demi"
  ]
}
